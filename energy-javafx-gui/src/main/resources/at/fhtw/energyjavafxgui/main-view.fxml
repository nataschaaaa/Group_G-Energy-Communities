<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefWidth="680" prefHeight="460"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="at.fhtw.energyjavafxgui.MainController">

    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

    <!-- Aktueller Status -->
    <Label text="Aktueller Energiestatus" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <Label text="Community Pool genutzt:"/>
        <Label fx:id="lblCommunityPool" text="—" style="-fx-font-weight: bold; -fx-text-fill: #2a7ae2;"/>
        <Label text="  |  Grid-Anteil:"/>
        <Label fx:id="lblGridPortion" text="—" style="-fx-font-weight: bold; -fx-text-fill: #e25c2a;"/>
    </HBox>

    <Button text="Aktualisieren" onAction="#onRefreshClick" style="-fx-padding: 4 12;"/>

    <Separator/>

    <!-- Historische Daten -->
    <Label text="Historische Daten" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Start:"/>
        <DatePicker fx:id="dpStart"/>
        <Label text="Ende:"/>
        <DatePicker fx:id="dpEnd"/>
        <Button text="Anzeigen" onAction="#onShowDataClick" style="-fx-padding: 4 12;"/>
    </HBox>

    <!-- TableView -->
    <TableView fx:id="historicalTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colHour"     text="Zeitpunkt"          prefWidth="185"/>
            <TableColumn fx:id="colProduced" text="Produziert (kWh)"   prefWidth="155"/>
            <TableColumn fx:id="colUsed"     text="Verbraucht (kWh)"   prefWidth="155"/>
            <TableColumn fx:id="colGrid"     text="Netz genutzt (kWh)" prefWidth="155"/>
        </columns>
        <placeholder>
            <Label text="Zeitraum wählen und 'Anzeigen' klicken."/>
        </placeholder>
    </TableView>

    <Label fx:id="lblStatus" text="" style="-fx-text-fill: #666; -fx-font-size: 11px;"/>
</VBox>